<%- include("partials/header", { title: title }) %>

<main>
  <h1>Project Categories</h1>
  <p>Explore our service categories.</p>

  <section class="card-grid">
    <% categories.forEach(category => { %>
      <article class="card">
        <h2><%= category.name %></h2>
      </article>
    <% }) %>
  </section>
</main>

<%- include("partials/footer") %>