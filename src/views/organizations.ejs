
<%- include("partials/header", { title: title }) %>

<main>
  <h1>Community Organizations</h1>
  <p>Discover organizations making a difference.</p>

  <section class="card-grid">
    <article class="card">
      <img
        src="/images/food-bank.jpg"
        alt="Volunteers organizing food donations"
      >
      <h2>Community Food Bank</h2>
      <p>Helping families access nutritious food.</p>
    </article>

    <article class="card">
      <img
        src="/images/environment.jpg"
        alt="Volunteers planting trees"
      >
      <h2>Green Earth Volunteers</h2>
      <p>Protecting the environment through service.</p>
