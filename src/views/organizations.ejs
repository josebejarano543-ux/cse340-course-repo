    <article class="card">
      <img
        src="/images/education.jpg"
        alt="Volunteers helping students learn"
      >
      <h2>Education for All</h2>
      <p>Supporting students and local education.</p>
    </article>
  </section>
</main>

<%- include("partials/footer") %>
